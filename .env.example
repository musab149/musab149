# Public URL of the deployed site (no trailing slash). Used for canonical URLs,
# Open Graph, sitemap and robots. Use the Vercel URL until ahmedmusab.com is live.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery (Resend). All three are required for the form to send.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "Ahmed Musab <hello@ahmedmusab.com>"
CONTACT_FROM_EMAIL=

# Optional: Cloudflare Turnstile spam protection (both keys required to enable).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: Upstash Redis rate limiting (falls back to best-effort in-memory limiting).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
